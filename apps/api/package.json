{
  "name": "@scout/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "node -e \"if(process.env.PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD==='1'){console.log('skip chromium');process.exit(0)} require('child_process').execSync('playwright install chromium',{stdio:'inherit'})\""
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.0",
    "@scout/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "nanoid": "^5.1.0",
    "openai": "^4.104.0",
    "playwright": "1.50.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
